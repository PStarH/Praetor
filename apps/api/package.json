{
  "name": "@praetor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.././../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json && node .././../scripts/fix-esm-imports.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @praetor/postgres-runtime --filter @praetor/plugin-sdk build && pnpm --filter @praetor/effect-broker --filter @praetor/core --filter @praetor/kernel build && pnpm build",
    "test": "node --import tsx --test test/*.test.cjs test/*.test.ts test/ws9/*.test.ts",
    "test:integration": "node --import tsx scripts/run-integration-tests.ts"
  },
  "author": "PStarH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PStarH/Praetor"
  },
  "bugs": {
    "url": "https://github.com/PStarH/Praetor/issues"
  },
  "homepage": "https://github.com/PStarH/Praetor#readme",
  "engines": {
    "node": ">=22.9.0 <23.0.0"
  },
  "dependencies": {
    "@praetor/contracts": "workspace:*",
    "@praetor/core": "workspace:*",
    "@praetor/effect-broker": "workspace:*",
    "@praetor/kernel": "workspace:*",
    "@praetor/postgres-runtime": "workspace:*",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "redis": "^5.11.0",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1",
    "pg": "^8.15.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.11.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.8.2"
  }
}
