{
  "name": "@praetor/sdk",
  "version": "0.2.0",
  "description": "Commander Agent SDK — embed multi-agent orchestration in your own applications",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node .././../scripts/fix-esm-imports.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "commander",
    "sdk",
    "multi-agent",
    "ai",
    "orchestration",
    "typescript"
  ],
  "author": "PStarH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PStarH/Praetor",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/PStarH/Praetor/issues"
  },
  "homepage": "https://github.com/PStarH/Praetor#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@praetor/contracts": "workspace:*"
  },
  "peerDependencies": {
    "@praetor/core": "^0.2.0"
  },
  "devDependencies": {
    "@praetor/core": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.8.1",
    "typescript": "^5.0.0"
  }
}
