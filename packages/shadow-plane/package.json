{
  "name": "@commander/shadow-plane",
  "version": "0.1.0",
  "description": "Read-only historical policy evaluation for Commander Shadow pilots.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "commander-shadow": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test src/contracts.test.ts src/evaluator.test.ts src/comparison.test.ts src/startupConfig.test.ts src/repository.test.ts src/atomicExport.test.ts src/report.test.ts src/cli.test.ts",
    "test:postgres-live": "node --import tsx --test --test-force-exit src/repository.live.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@commander/contracts": "workspace:*",
    "@commander/postgres-runtime": "workspace:*",
    "json-canonicalize": "3.0.0",
    "pg": "^8.15.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  }
}
